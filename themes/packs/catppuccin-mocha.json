{
  "schemaVersion": 1,
  "id": "catppuccin-mocha",
  "name": "Catppuccin Studio",
  "author": "NekoChat",
  "version": "1.1.0",
  "description": "Soothing pastel Bento pack with Mocha & Frappé color schemes, keycap depth, and soft spring physics.",
  "badge": "Catp",
  "baseSkin": "bento",
  "supportsBuiltInPalettes": true,
  "defaultPaletteId": "catppuccin-mocha",
  "tags": ["Pastel", "Cozy", "OLED"],
  "palettes": [
    {
      "id": "catppuccin-mocha",
      "name": "Catppuccin Mocha",
      "desc": "Espresso OLED dark + Pastel Mauve (#CBA6F7)",
      "accent": "#CBA6F7",
      "accentMuted": "#B4BEFE",
      "accentRgb": "203, 166, 247",
      "bgDark": "#11111B",
      "bgSurface": "#1E1E2E",
      "bgSurfaceSubtle": "#313244",
      "webFrameBg": "#0B0B12",
      "dockBg": "rgba(24, 24, 37, 0.92)"
    },
    {
      "id": "catppuccin-frappe",
      "name": "Catppuccin Frappé",
      "desc": "Cool twilight slate + Soft Flamingo Rose (#F4B8E4)",
      "accent": "#F4B8E4",
      "accentMuted": "#CA9EE6",
      "accentRgb": "244, 184, 228",
      "bgDark": "#232634",
      "bgSurface": "#303446",
      "bgSurfaceSubtle": "#414559",
      "webFrameBg": "#1A1C26",
      "dockBg": "rgba(41, 44, 60, 0.92)"
    }
  ],
  "layout": {
    "navBarStyle": "floating_capsule",
    "settingsLayout": "bento_grid",
    "switchStyle": "neko"
  },
  "surfaces": {
    "surfaceMode": "oled",
    "cardBorderAccentMix": 0.16,
    "keycapLipWidth": 3.5,
    "userBubbleBg": "rgba(203, 166, 247, 0.18)",
    "aiBubbleBg": "#1E1E2E"
  },
  "geometry": {
    "cardRadius": 22,
    "buttonRadius": 16,
    "bubbleRadius": 20,
    "bubbleTailRadius": 6,
    "sheetRadius": 28,
    "dockRadius": 30
  },
  "animation": {
    "mode": "spring",
    "speedScale": 1.0,
    "easing": "cubicOut",
    "springFriction": 7,
    "springTension": 130,
    "pressScale": 0.95,
    "pressFriction": 6,
    "pressTension": 185,
    "dockSpringFriction": 7,
    "dockSpringTension": 135,
    "sheetOpenDuration": 270,
    "sheetCloseDuration": 210,
    "screenEnterFriction": 8.5,
    "screenEnterTension": 95,
    "switchFriction": 7.5,
    "switchTension": 125
  }
}
