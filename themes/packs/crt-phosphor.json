  "animation": {
    "mode": "timing",
    "speedScale": 0.65,
    "easing": "expoOut",
    "enterDuration": 140,
    "pressDuration": 80,
    "pressScale": 0.97,
    "sheetOpenDuration": 160,
    "sheetCloseDuration": 130,
    "screenExitDuration": 130,
    "tabFadeDuration": 110,
    "composerDuration": 140,
    "collapsibleDuration": 120
